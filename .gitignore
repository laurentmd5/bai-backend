nbproject/
nbbuild/
dist/
nbdist/

# =============================================================================
# DOCKER
# =============================================================================

# Docker volumes
docker-volumes/
data/
*.tar.gz

# Docker compose override (local)
docker-compose.override.yml

# =============================================================================
# LOGS & DONNÉES
# =============================================================================

# Logs
logs/
*.log
*.log.*

# Base de données locale
*.db
*.sqlite
*.sqlite3

# Backups
backups/
*.dump
*.rdb
*.aof

# Uploads
uploads/*
!uploads/.gitkeep

# Données temporaires
tmp/
temp/
*.tmp
*.temp

# =============================================================================
# SYSTÈME D'EXPLOITATION
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# DIVERS
# =============================================================================

# Fichiers de test
test_results.txt
test_results.xml
.pytest_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

# Profiling
*.prof
*.lprof

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Fichiers volumineux (> 50MB)
*.large

# =============================================================================
# SPÉCIFIQUE BARROW.AI - NE PAS COMMITTER
# =============================================================================

# Tokens d'accès temporaires
*.token
tokens/

# Données de session
sessions/

# Configuration locale de Traefik (peut contenir des IPs)
traefik/acme.json

