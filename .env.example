# =============================================================================
# BARROW.AI POC - Environment Variables Template
# Copy to .env and fill with actual values
# =============================================================================

# Application
APP_NAME=BARROW.AI POC
APP_VERSION=4.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Identité de la société (utilisée dans les messages, emails et réponses automatiques)
# Ces valeurs remplacent toutes les valeurs hardcodées dans le code.
COMPANY_NAME=NETSYSTEME Informatique
COMPANY_CONTACT_EMAIL=contact@netsys-info.com
COMPANY_CONTACT_PHONE=+221 33 827 28 45
COMPANY_WHATSAPP=+221 77 846 16 55
COMPANY_WEBSITE=https://netsys-info.com

# Database
POSTGRES_USER=barrowai
POSTGRES_PASSWORD=<generate_secure_password>
POSTGRES_DB=barrowai_poc
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_PASSWORD=<generate_secure_password>

# RabbitMQ
RABBITMQ_USER=barrowai
RABBITMQ_PASSWORD=<generate_secure_password>

# Qdrant
QDRANT_COLLECTION=netsysteme_knowledge_v1
QDRANT_SIMILARITY_THRESHOLD=0.70
QDRANT_API_KEY=<generate_secure_token>

# LLM principal : Groq (ultra-rapide, remplace Gemini en primaire)
LLM_PROVIDER=groq
GROQ_API_KEY=<your_groq_api_key>
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# LLM secondaire : Gemini (utilisé en fallback uniquement)
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_TOKENS=512
GEMINI_TIMEOUT=10

# Security
JWT_SECRET=<generate_64_char_hex>
JWT_REFRESH_SECRET=<generate_64_char_hex>
ENCRYPTION_KEY=<generate_32_byte_base64>
CSRF_SECRET=<generate_32_char_hex>
ADMIN_IP_WHITELIST=127.0.0.1,::1,172.20.0.0/16

# WhatsApp
WHATSAPP_VERIFY_TOKEN=<generate_secure_token>
WHATSAPP_ACCESS_TOKEN=<your_meta_access_token>
WHATSAPP_PHONE_NUMBER_ID=<your_phone_number_id>
WHATSAPP_APP_SECRET=<your_meta_app_secret>

# CORS
CORS_ORIGINS=https://widget.barrow-ai.poc,https://admin.barrow-ai.poc

# Rate Limiting
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_WHATSAPP_PER_MINUTE=10

# Domain
DOMAIN=barrow-ai.poc

# Cloudflare (for SSL)
CF_API_EMAIL=admin@barrow-ai.poc
CF_DNS_API_TOKEN=<your_cloudflare_api_token>

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Text-To-Speech (Edge TTS)
# Speech rate modifier: +25% = 1.25x speed, +0% = 1.0x (normal)
TTS_RATE=+25%
TTS_VOLUME=+0%
TTS_VOICE=

# Oolel TTS (Wolof)
OOLEL_TTS_TIMEOUT=90

# SMTP & Notifications Email
# Utilisé pour envoyer les alertes de candidatures et de demandes de devis.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your_sender_email@gmail.com>
SMTP_PASSWORD=<your_gmail_app_password>
SMTP_FROM=<Display Name <sender@gmail.com>>
SMTP_USE_TLS=true

# Email destinataire des alertes de candidatures (module recrutement)
RECRUITER_NOTIFICATION_EMAIL=<rh@yourcompany.com>

# Email destinataire des alertes de prospects/devis (module commercial)
SALES_NOTIFICATION_EMAIL=<commercial@yourcompany.com>
