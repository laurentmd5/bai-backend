// Déploiement sur VPS (Préproduction) via SSH
// Jenkins reste sur la VM Ubuntu locale

pipeline {
    agent any
    
    environment {
        // Configuration Docker Hub (À configurer dans les credentials Jenkins)
        DOCKER_HUB_CREDENTIALS_ID = 'docker-hub-credentials'
        DOCKER_IMAGE_NAME = 'laurentmd5/barrow-backend' 
        DOCKER_IMAGE_TAG = "${BUILD_NUMBER}"
        
        // Configuration VPS (À configurer dans les credentials Jenkins)
        VPS_HOST = 'barrowai.sse.sn'
        VPS_USER = 'deployer'
        VPS_SSH_CREDENTIALS_ID = 'vps-preprod-ssh'
        DEPLOY_PATH = '/opt/barrow-ai-preprod'
        
        // Fichiers
        COMPOSE_FILE = 'docker-compose.yml'
        DOMAIN = 'barrowai.sse.sn'
    }
    
    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    stages {
        
        stage('Clone') {
            steps {
                echo 'Clonage du depot GitHub sur la VM Jenkins...'
                checkout scm
                script {
                    currentBuild.displayName = "#${BUILD_NUMBER} - ${GIT_COMMIT.take(8)}"
                }
            }
        }
        
        stage('Build & Push') {
            steps {
                script {
                    echo "Construction de l'image : ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}"
                    docker.build("${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}", "-f Dockerfile .")
                    
                    echo "Push de l'image vers Docker Hub..."
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_HUB_CREDENTIALS_ID}") {
                        docker.image("${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}").push()
                        docker.image("${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}").push('latest')
                    }
                }
            }
        }
        
        stage('Transfert Config') {
            steps {
                echo "Transfert des fichiers de configuration vers le VPS (${VPS_HOST})..."
                sshagent (credentials: ["${VPS_SSH_CREDENTIALS_ID}"]) {
                    sh """
                        # Creer l'arborescence
                        ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS_HOST} "mkdir -p ${DEPLOY_PATH}/logs ${DEPLOY_PATH}/scripts ${DEPLOY_PATH}/traefik"

                        # Transferer docker-compose
                        scp -o StrictHostKeyChecking=no ${WORKSPACE}/${COMPOSE_FILE} ${VPS_USER}@${VPS_HOST}:${DEPLOY_PATH}/
                        
                        # Transferer les scripts et traefik
                        scp -o StrictHostKeyChecking=no -r ${WORKSPACE}/scripts/* ${VPS_USER}@${VPS_HOST}:${DEPLOY_PATH}/scripts/
                        scp -o StrictHostKeyChecking=no -r ${WORKSPACE}/traefik/* ${VPS_USER}@${VPS_HOST}:${DEPLOY_PATH}/traefik/
                    """
                }
            }
        }

        stage('Deploiement & Migration') {
            steps {
                echo "Preparation du script de deploiement..."
                // Utilisation de writeFile pour eviter les problemes d'echappement Groovy/Bash via SSH
                writeFile file: 'deploy.sh', text: """#!/bin/bash
set -e

cd ${DEPLOY_PATH}
export DOMAIN=${DOMAIN}
export BACKEND_IMAGE=${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}

echo 'Pull de la nouvelle image depuis Docker Hub...'
docker pull ${DOCKER_IMAGE_NAME}:${DOCKER_IMAGE_TAG}

echo 'Redemarrage des conteneurs...'
docker compose -f ${COMPOSE_FILE} down --remove-orphans || true
docker compose -f ${COMPOSE_FILE} up -d --force-recreate

echo 'Attente du demarrage (10s)...'
sleep 10

echo 'Application du schema de base de donnees...'
docker compose -f ${COMPOSE_FILE} exec -T backend python scripts/db_migrate.py

echo 'Verification et creation admin initial...'
ADMIN_COUNT=\$(docker compose -f ${COMPOSE_FILE} exec -T postgres psql -U barrowai -d barrowai_poc -tAq -c 'SELECT COUNT(*) FROM admin_users;' 2>/dev/null || echo 0)

if [ "\$ADMIN_COUNT" = "0" ]; then
    echo 'Creation du compte initial...'
    docker compose -f ${COMPOSE_FILE} exec -T backend python scripts/create_admin.py --email admin@pace.gm --name 'PACE Admin' --role superadmin --password Admin123!
else
    echo 'Administrateurs existants. Creation ignoree.'
fi

echo 'Initialisation de Qdrant...'
docker compose -f ${COMPOSE_FILE} exec -T backend python scripts/init_qdrant.py || true
"""
                
                echo "Execution du script sur le VPS..."
                sshagent (credentials: ["${VPS_SSH_CREDENTIALS_ID}"]) {
                    sh """
                        scp -o StrictHostKeyChecking=no deploy.sh ${VPS_USER}@${VPS_HOST}:${DEPLOY_PATH}/deploy.sh
                        ssh -o StrictHostKeyChecking=no ${VPS_USER}@${VPS_HOST} "bash ${DEPLOY_PATH}/deploy.sh"
                    """
                }
                sleep(time: 15, unit: 'SECONDS')
            }
        }

        stage('Verifier') {
            steps {
                script {
                    echo "Verification de la sante du service sur https://api.${DOMAIN}/health/live"
                    def ok = false
                    for (int i = 0; i < 20; i++) {
                        def status = sh(
                            script: "curl -s -o /dev/null -w '%{http_code}' https://api.${DOMAIN}/health/live || echo 000",
                            returnStdout: true
                        ).trim()
                        if (status == '200') {
                            ok = true
                            echo "Service healthy (tentative ${i + 1})"
                            break
                        }
                        sleep(time: 5, unit: 'SECONDS')
                    }
                    if (!ok) error("Service non healthy apres 20 tentatives")
                }
            }
        }

        stage('Nettoyer') {
            steps {
                echo "Nettoyage..."
                sh 'rm -f deploy.sh || true'
                sh 'docker image prune -f || true'
            }
        }
    }
    
    post {
        success {
            echo """
========================================
     DEPLOIEMENT VPS REUSSI !
========================================
  API     : https://api.${DOMAIN}/health/live
  Docs    : https://api.${DOMAIN}/docs
========================================"""
        }
        failure {
            echo "Echec du deploiement. Verifiez les logs."
        }
    }
}
